# Copy to .env.local for native backend development only. Never put real secrets here.
# Docker Compose sets its own environment and mounts generated local secret files.
INSIGHTRAG_ENVIRONMENT=development
INSIGHTRAG_LOG_LEVEL=INFO
INSIGHTRAG_POOL_SIZE=5
INSIGHTRAG_POOL_MAX_OVERFLOW=5
INSIGHTRAG_POOL_TIMEOUT_SECONDS=3
INSIGHTRAG_DEPENDENCY_TIMEOUT_SECONDS=2

# After node scripts/bootstrap-local.mjs and starting local PostgreSQL/Redis:
# INSIGHTRAG_DATABASE_URL_FILE=.secrets/host_database_url
# INSIGHTRAG_REDIS_URL_FILE=.secrets/host_redis_url
# INSIGHTRAG_SIGNED_JOB_KEY_FILE=.secrets/signed_job_key
# Set migration credentials only in a one-shot operator shell, never the API/worker.
# INSIGHTRAG_MIGRATION_DATABASE_URL_FILE=.secrets/host_migration_database_url

# Enterprise identity: configure all three with your registered provider values.
# Required profile and privileged provisioning: docs/operations/phase-03-security.md
# INSIGHTRAG_OIDC_ISSUER=https://your-approved-issuer.example/tenant
# INSIGHTRAG_OIDC_AUDIENCE=your-registered-api-audience
# INSIGHTRAG_OIDC_JWKS_URL=https://your-approved-issuer.example/tenant/jwks
INSIGHTRAG_RATE_LIMIT_PER_USER=60
INSIGHTRAG_RATE_LIMIT_PER_ORGANIZATION=600
INSIGHTRAG_UPLOAD_MAX_BYTES=52428800
# Unconfigured malware scanner fails closed; no fake clean result.
# INSIGHTRAG_CLAMAV_HOST=your-controlled-scanner
# INSIGHTRAG_CLAMAV_PORT=3310

# Phase 4 private object storage and embedding provider (all required for document ingestion).
# Keep IAM/object-store credentials outside this file; use an instance role or secret mount.
# INSIGHTRAG_OBJECT_BUCKET=your-private-regional-bucket
# INSIGHTRAG_OBJECT_REGION=your-approved-region
# INSIGHTRAG_OBJECT_KMS_KEY_ID=your-managed-key-identifier
# INSIGHTRAG_OBJECT_ENDPOINT=https://your-private-s3-compatible-endpoint
# INSIGHTRAG_EMBEDDING_ENDPOINT=https://your-approved-provider/embeddings
# INSIGHTRAG_EMBEDDING_API_KEY_FILE=.secrets/embedding_api_key
# INSIGHTRAG_EMBEDDING_MODEL=your-1536-dimensional-model
# INSIGHTRAG_INGESTION_OCR_ENABLED=false

# Phase 5 document RAG. The embedding model must match the active indexed version.
# INSIGHTRAG_GENERATION_ENDPOINT=https://your-approved-provider/chat/completions
# INSIGHTRAG_GENERATION_API_KEY_FILE=.secrets/generation_api_key
# INSIGHTRAG_GENERATION_MODEL=your-approved-chat-model
# INSIGHTRAG_GENERATION_TEMPERATURE=0
# INSIGHTRAG_GENERATION_MAX_COMPLETION_TOKENS=800
# INSIGHTRAG_RETRIEVAL_DENSE_K=20
# INSIGHTRAG_RETRIEVAL_SPARSE_K=20
# INSIGHTRAG_RETRIEVAL_FUSION_K=20
# INSIGHTRAG_RETRIEVAL_CONTEXT_K=6
# INSIGHTRAG_RETRIEVAL_CONTEXT_TOKENS=2400
# INSIGHTRAG_RETRIEVAL_MAX_COSINE_DISTANCE=0.5 # example only; calibrate before use
# Optional authorized-candidate reranker API: {scores:[float,...]} contract.
# INSIGHTRAG_RERANK_ENDPOINT=https://your-approved-reranker/rerank
# INSIGHTRAG_RERANK_API_KEY_FILE=.secrets/rerank_api_key
# INSIGHTRAG_RERANK_MODEL=your-approved-reranker

# NEXT_PUBLIC_API_BASE_URL is public frontend build configuration, never a secret.
# Configure it for Next in apps/web/.env.local if you need a non-default origin.
